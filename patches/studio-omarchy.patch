+import { describe, expect, it } from 'vitest';
+import { getLinuxUpdateAction, isStudioOmarchyPackage } from 'src/lib/linux-update';
+
+describe( 'linux-update', () => {
+	it( 'detects Omarchy from its session environment', () => {
+		expect(
+			isStudioOmarchyPackage( {
+				OMARCHY_PATH: '/usr/share/omarchy',
+				STUDIO_OMARCHY_PACKAGE: '1',
+			} )
+		).toBe( true );
+		expect( isStudioOmarchyPackage( { OMARCHY_PATH: '/usr/share/omarchy' } ) ).toBe( false );
+		expect( isStudioOmarchyPackage( { STUDIO_OMARCHY_PACKAGE: '1' } ) ).toBe( false );
+	} );
+
+	it( 'routes Omarchy updates through the system update command', () => {
+		expect(
+			getLinuxUpdateAction( 'studio-x64-v1.18.0.deb', {
+				OMARCHY_PATH: '/usr/share/omarchy',
+				STUDIO_OMARCHY_PACKAGE: '1',
+			} )
+		).toEqual( {
+			command: 'studio-omarchy-update',
+			shouldDownload: false,
+		} );
+	} );
+
+	it( 'keeps the DEB installation flow on other Linux systems', () => {
+		expect( getLinuxUpdateAction( 'studio-x64-v1.18.0.deb', {} ) ).toEqual( {
+			command: 'sudo apt install ~/Downloads/studio-x64-v1.18.0.deb',
+			shouldDownload: true,
+		} );
+	} );
+
+	it( 'does not change the updater for other Studio packages running on Omarchy', () => {
+		expect(
+			getLinuxUpdateAction( 'studio-x64-v1.18.0.deb', {
+				OMARCHY_PATH: '/usr/share/omarchy',
+			} )
+		).toEqual( {
+			command: 'sudo apt install ~/Downloads/studio-x64-v1.18.0.deb',
+			shouldDownload: true,
+		} );
+	} );
+} );
diff --git a/packages/common/lib/linux-distribution.ts b/packages/common/lib/linux-distribution.ts
new file mode 100644
index 00000000..7ca83c00
--- /dev/null
+++ b/packages/common/lib/linux-distribution.ts
@@ -0,0 +1,46 @@
+import fs from 'node:fs';
+
+export interface LinuxDistribution {
+	id: string;
+	idLike: string[];
+}
+
+function unquoteOsReleaseValue( value: string ): string {
+	const trimmed = value.trim();
+	if (
+		( trimmed.startsWith( '"' ) && trimmed.endsWith( '"' ) ) ||
+		( trimmed.startsWith( "'" ) && trimmed.endsWith( "'" ) )
+	) {
+		return trimmed.slice( 1, -1 );
+	}
+	return trimmed;
+}
+
+export function parseLinuxOsRelease( contents: string ): LinuxDistribution {
+	const fields = new Map< string, string >();
+	for ( const line of contents.split( /\r?\n/ ) ) {
+		const match = line.match( /^([A-Z_]+)=(.*)$/ );
+		if ( match ) {
+			fields.set( match[ 1 ], unquoteOsReleaseValue( match[ 2 ] ) );
+		}
+	}
+
+	return {
+		id: ( fields.get( 'ID' ) ?? '' ).toLowerCase(),
+		idLike: ( fields.get( 'ID_LIKE' ) ?? '' ).toLowerCase().split( /\s+/ ).filter( Boolean ),
+	};
+}
+
+export function getLinuxDistribution(
+	osReleasePath: string = '/etc/os-release'
+): LinuxDistribution {
+	try {
+		return parseLinuxOsRelease( fs.readFileSync( osReleasePath, 'utf8' ) );
+	} catch {
+		return { id: '', idLike: [] };
+	}
+}
+
+export function isArchBasedLinux( distribution: LinuxDistribution = getLinuxDistribution() ) {
+	return [ distribution.id, ...distribution.idLike ].includes( 'arch' );
+}
