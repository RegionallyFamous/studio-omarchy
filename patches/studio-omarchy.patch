+++ b/packages/common/lib/tests/linux-distribution.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { isArchBasedLinux, parseLinuxOsRelease } from '@studio/common/lib/linux-distribution';
+
+describe( 'linux-distribution', () => {
+	it( 'parses quoted os-release fields', () => {
+		expect( parseLinuxOsRelease( 'NAME="Arch Linux"\nID=arch\nBUILD_ID=rolling\n' ) ).toEqual( {
+			id: 'arch',
+			idLike: [],
+		} );
+	} );
+
+	it( 'parses ID_LIKE as a normalized list', () => {
+		expect( parseLinuxOsRelease( 'ID=endeavouros\nID_LIKE="Arch linux"\n' ) ).toEqual( {
+			id: 'endeavouros',
+			idLike: [ 'arch', 'linux' ],
+		} );
+	} );
+
+	it( 'identifies Arch and Arch-derived distributions', () => {
+		expect( isArchBasedLinux( { id: 'arch', idLike: [] } ) ).toBe( true );
+		expect( isArchBasedLinux( { id: 'cachyos', idLike: [ 'arch' ] } ) ).toBe( true );
+		expect( isArchBasedLinux( { id: 'ubuntu', idLike: [ 'debian' ] } ) ).toBe( false );
+	} );
+} );
