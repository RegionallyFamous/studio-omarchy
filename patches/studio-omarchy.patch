+import { beforeAll, describe, expect, it, vi } from 'vitest';
+import type { ServerConfig } from 'cli/lib/types/wordpress-server-ipc';
+import type { EventEmitter } from 'node:events';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+
+type PhpServerChildModule = typeof import('../php-server-child');
+
+let phpServerChild: PhpServerChildModule;
+
+function removeAddedListeners(
+	emitter: EventEmitter,
+	event: string,
+	originalListeners: ReturnType< EventEmitter[ 'listeners' ] >
+): void {
+	for ( const listener of emitter.listeners( event ) ) {
+		if ( ! originalListeners.includes( listener ) ) {
+			emitter.removeListener( event, listener as ( ...args: unknown[] ) => void );
+		}
+	}
+}
+
+beforeAll( async () => {
+	const processEmitter = process as EventEmitter;
+	const originalSend = process.send;
+	const originalListeners = {
+		exit: process.listeners( 'exit' ),
+		disconnect: process.listeners( 'disconnect' ),
+		SIGTERM: process.listeners( 'SIGTERM' ),
+		SIGINT: process.listeners( 'SIGINT' ),
+		message: process.listeners( 'message' ),
+	};
+
+	process.send = vi.fn() as typeof process.send;
+	try {
+		phpServerChild = await import( '../php-server-child' );
+	} finally {
+		removeAddedListeners( processEmitter, 'exit', originalListeners.exit );
+		removeAddedListeners( processEmitter, 'disconnect', originalListeners.disconnect );
+		removeAddedListeners( processEmitter, 'SIGTERM', originalListeners.SIGTERM );
+		removeAddedListeners( processEmitter, 'SIGINT', originalListeners.SIGINT );
+		removeAddedListeners( processEmitter, 'message', originalListeners.message );
+		process.send = originalSend;
+	}
+} );
+
+async function closeServer( server: Server ): Promise< void > {
+	await new Promise< void >( ( resolve ) => server.close( () => resolve() ) );
+}
+
+describe( 'native PHP proxy network binding', () => {
+	it( 'listens only on IPv4 loopback', async () => {
+		const server = await phpServerChild.startPhpProxyServer( {
+			port: 0,
+		} as ServerConfig );
+
+		try {
+			const address = server.address() as AddressInfo;
+			expect( address.address ).toBe( '127.0.0.1' );
+			expect( address.family ).toBe( 'IPv4' );
+		} finally {
+			await closeServer( server );
+		}
+	} );
+} );
