diff --git a/apps/studio/src/lib/linux-update.ts b/apps/studio/src/lib/linux-update.ts
new file mode 100644
index 00000000..f4d96a90
--- /dev/null
+++ b/apps/studio/src/lib/linux-update.ts
@@ -0,0 +1,25 @@
+export interface LinuxUpdateAction {
+	command: string;
+	shouldDownload: boolean;
+}
+
+export function isStudioOmarchyPackage( env: NodeJS.ProcessEnv = process.env ): boolean {
+	return Boolean( env.OMARCHY_PATH ) && env.STUDIO_OMARCHY_PACKAGE === '1';
+}
+
+export function getLinuxUpdateAction(
+	debFilename: string,
+	env: NodeJS.ProcessEnv = process.env
+): LinuxUpdateAction {
+	if ( isStudioOmarchyPackage( env ) ) {
+		return {
+			command: 'studio-omarchy-update',
+			shouldDownload: false,
+		};
+	}
+
+	return {
+		command: `sudo apt install ~/Downloads/${ debFilename }`,
+		shouldDownload: true,
+	};
+}
