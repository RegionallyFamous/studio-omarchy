+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { readCliConfig } from 'cli/lib/cli-config/core';
+import { isProxyRunning, startProxyServers, stopProxyServers } from 'cli/lib/proxy-server';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+
+const mocks = vi.hoisted( () => {
+	const httpServers: Array< ReturnType< typeof createServer > > = [];
+	const httpsServers: Array< ReturnType< typeof createServer > > = [];
+	const proxyWeb = vi.fn();
+
+	function createServer( handler: ( req: unknown, res: unknown ) => unknown ) {
+		const server = {
+			handler,
+			listening: false,
+			listen: vi.fn(),
+			on: vi.fn(),
+			close: vi.fn(),
+		};
+
+		server.listen.mockImplementation( ( _port: number, _host: string, callback: () => void ) => {
+			server.listening = true;
+			callback();
+			return server;
+		} );
+		server.on.mockReturnValue( server );
+		server.close.mockImplementation( ( callback: () => void ) => {
+			server.listening = false;
+			callback();
+			return server;
+		} );
+
+		return server;
+	}
+
+	return {
+		httpServers,
+		httpsServers,
+		proxyWeb,
+		createHttpServer: vi.fn( ( handler ) => {
+			const server = createServer( handler );
+			httpServers.push( server );
+			return server;
+		} ),
+		createHttpsServer: vi.fn( ( _options, handler ) => {
+			const server = createServer( handler );
+			httpsServers.push( server );
+			return server;
+		} ),
+	};
+} );
+
+vi.mock( 'http', () => ( {
+	default: {
+		createServer: mocks.createHttpServer,
+		ServerResponse: class ServerResponse {},
+	},
+} ) );
+
+vi.mock( 'https', () => ( {
+	default: {
+		createServer: mocks.createHttpsServer,
+	},
+} ) );
+
+vi.mock( 'http-proxy', () => ( {
+	default: {
+		createProxyServer: () => ( {
+			on: vi.fn(),
+			web: mocks.proxyWeb,
+		} ),
+	},
+} ) );
+
+vi.mock( 'cli/lib/certificate-manager', () => ( {
+	generateSiteCertificate: vi.fn(),
+} ) );
+
+vi.mock( 'cli/lib/cli-config/core', () => ( {
+	readCliConfig: vi.fn(),
+} ) );
+
+function createResponse() {
+	return {
+		writeHead: vi.fn(),
+		end: vi.fn(),
+	} as unknown as ServerResponse;
+}
+
+async function dispatch(
+	server: ( typeof mocks.httpServers )[ number ],
+	request: Partial< IncomingMessage >,
+	response: ServerResponse
+): Promise< void > {
+	await server.handler( request as IncomingMessage, response );
+}
+
+describe( 'proxy-server loopback listeners', () => {
+	beforeEach( () => {
+		mocks.httpServers.length = 0;
+		mocks.httpsServers.length = 0;
+		mocks.createHttpServer.mockClear();
+		mocks.createHttpsServer.mockClear();
+		mocks.proxyWeb.mockReset();
+		vi.mocked( readCliConfig ).mockReset();
+		vi.spyOn( console, 'log' ).mockImplementation( () => undefined );
+		vi.spyOn( console, 'error' ).mockImplementation( () => undefined );
+		vi.spyOn( process, 'on' ).mockImplementation( () => process );
+		vi.spyOn( process.stdin, 'resume' ).mockImplementation( () => process.stdin );
+	} );
+
+	afterEach( async () => {
+		await stopProxyServers();
+		vi.restoreAllMocks();
+	} );
+
+	it( 'binds HTTP, HTTPS, and their health handlers only to IPv4 and IPv6 loopback', async () => {
+		await startProxyServers();
+
+		const httpBindings = mocks.httpServers.map( ( server ) => server.listen.mock.calls[ 0 ] );
+		const httpsBindings = mocks.httpsServers.map( ( server ) => server.listen.mock.calls[ 0 ] );
+
+		expect( httpBindings.map( ( [ port, host ] ) => [ port, host ] ) ).toEqual( [
+			[ 80, '127.0.0.1' ],
+			[ 80, '::1' ],
+		] );
+		expect( httpsBindings.map( ( [ port, host ] ) => [ port, host ] ) ).toEqual( [
+			[ 443, '127.0.0.1' ],
+			[ 443, '::1' ],
+		] );
+
+		for ( const [ , host ] of [ ...httpBindings, ...httpsBindings ] ) {
+			expect( host ).not.toBeUndefined();
+			expect( host ).not.toBe( '0.0.0.0' );
+			expect( host ).not.toBe( '::' );
+		}
+
+		const response = createResponse();
+		await dispatch( mocks.httpServers[ 0 ], { url: '/__studio_health', headers: {} }, response );
+
+		expect( response.writeHead ).toHaveBeenCalledWith( 200, {
+			'Content-Type': 'application/json',
+		} );
+		expect( JSON.parse( vi.mocked( response.end ).mock.calls[ 0 ][ 0 ] as string ) ).toMatchObject(
+			{
+				status: 'ok',
+				http: true,
+				https: true,
+			}
+		);
+		expect( isProxyRunning() ).toBe( true );
+	} );
+
+	it( 'proxies a local custom domain through both IPv4 and IPv6 HTTP listeners', async () => {
+		vi.mocked( readCliConfig ).mockResolvedValue( {
+			sites: [
+				{
+					customDomain: 'custom-site.local',
+					port: 8881,
+					enableHttps: false,
+				},
+			],
+		} as Awaited< ReturnType< typeof readCliConfig > > );
+		await startProxyServers();
+
+		for ( const server of mocks.httpServers ) {
+			await dispatch(
+				server,
+				{ url: '/wp-json/', headers: { host: 'custom-site.local' } },
+				createResponse()
+			);
+		}
+
+		expect( mocks.proxyWeb ).toHaveBeenCalledTimes( 2 );
+		for ( const call of mocks.proxyWeb.mock.calls ) {
+			expect( call[ 2 ] ).toEqual( {
+				target: 'http://localhost:8881',
+				xfwd: true,
+				headers: {},
+			} );
+		}
+	} );
+
+	it( 'proxies an HTTPS custom domain locally and preserves forwarded protocol', async () => {
+		vi.mocked( readCliConfig ).mockResolvedValue( {
+			sites: [
+				{
+					customDomain: 'secure-site.local',
+					port: 8882,
+					enableHttps: true,
+				},
+			],
+		} as Awaited< ReturnType< typeof readCliConfig > > );
+		await startProxyServers();
+
+		await dispatch(
+			mocks.httpsServers[ 1 ],
+			{ url: '/', headers: { host: 'secure-site.local' } },
+			createResponse()
+		);
+
+		expect( mocks.proxyWeb ).toHaveBeenCalledWith(
+			expect.objectContaining( { headers: { host: 'secure-site.local' } } ),
+			expect.anything(),
+			{
+				target: 'http://localhost:8882',
+				xfwd: true,
+				headers: { 'X-Forwarded-Proto': 'https' },
+			}
+		);
+	} );
+} );
