+	const preservePreviousAnchor =
+		`if [ -e '${ trustStorePath }' ] || [ -L '${ trustStorePath }' ]; then ` +
+		`/usr/bin/cp -a -- '${ trustStorePath }' '${ backupCopyPath }' && ` +
+		`/usr/bin/mv -fT -- '${ backupCopyPath }' '${ backupPath }'; else ` +
+		`/usr/bin/touch '${ noPreviousAnchorPath }'; fi`;
+	const rollback =
+		`if { ${ verifyInstalledAnchor }; }; then ` +
+		`if [ -e '${ backupPath }' ] || [ -L '${ backupPath }' ]; then ` +
+		`/usr/bin/mv -fT -- '${ backupPath }' '${ trustStorePath }' || { ` +
+		`${ updateCommand } >/dev/null 2>&1 || true; ` +
+		`/usr/bin/rm -f -- ${ rollbackFailureCleanupPaths }; exit 1; }; ` +
+		`elif [ -e '${ noPreviousAnchorPath }' ]; then ` +
+		`/usr/bin/rm -f -- '${ trustStorePath }' || { ` +
+		`${ updateCommand } >/dev/null 2>&1 || true; ` +
+		`/usr/bin/rm -f -- ${ rollbackFailureCleanupPaths }; exit 1; }; fi; fi; ` +
+		`${ updateCommand } >/dev/null 2>&1 || true; ` +
+		`/usr/bin/rm -f -- ${ cleanupPaths }; exit 1`;
