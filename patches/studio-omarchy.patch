+/**
+ * @vitest-environment node
+ */
+import fs from 'node:fs';
+import {
+	areAllFirefoxProfilesTrustedLinux,
+	buildLinuxTrustInstallCommand,
+	getLinuxTrustStoreConfig,
+	importCAIntoFirefoxProfilesLinux,
+	importCAIntoUserNssDbsLinux,
+	isCAImportedInUserNssDbsLinux,
+	isCATrustedOnLinux,
+	readLinuxTrustCertificate,
+} from '@studio/common/lib/linux-trust-store';
+import sudo from '@vscode/sudo-prompt';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { trustRootCA } from 'src/lib/certificate-manager';
+
+vi.mock( 'electron', () => ( {
+	shell: { showItemInFolder: vi.fn() },
+} ) );
+
+vi.mock( '@sentry/electron/main', () => ( {
+	captureException: vi.fn(),
+} ) );
+
+vi.mock( '@studio/common/lib/well-known-paths', () => ( {
+	getCertificatesPath: () => '/home/user/.studio/certificates',
+} ) );
+
+vi.mock( '@studio/common/lib/linux-trust-store', () => ( {
+	areAllFirefoxProfilesTrustedLinux: vi.fn(),
+	buildLinuxTrustInstallCommand: vi.fn(),
+	getLinuxTrustStoreConfig: vi.fn( () => ( {
+		trustStorePath: '/usr/local/share/ca-certificates/studio-ca.crt',
+		updateCommand: '/usr/sbin/update-ca-certificates',
+	} ) ),
+	importCAIntoFirefoxProfilesLinux: vi.fn(),
+	importCAIntoUserNssDbsLinux: vi.fn(),
+	isCAImportedInUserNssDbsLinux: vi.fn(),
+	isCATrustedOnLinux: vi.fn(),
+	readLinuxTrustCertificate: vi.fn(),
+} ) );
+
+vi.mock( '@vscode/sudo-prompt', () => ( {
+	default: { exec: vi.fn() },
+} ) );
+
+const mockedAreAllFirefoxProfilesTrustedLinux = vi.mocked( areAllFirefoxProfilesTrustedLinux );
+const mockedBuildLinuxTrustInstallCommand = vi.mocked( buildLinuxTrustInstallCommand );
+const mockedGetLinuxTrustStoreConfig = vi.mocked( getLinuxTrustStoreConfig );
+const mockedImportCAIntoFirefoxProfilesLinux = vi.mocked( importCAIntoFirefoxProfilesLinux );
+const mockedImportCAIntoUserNssDbsLinux = vi.mocked( importCAIntoUserNssDbsLinux );
+const mockedIsCAImportedInUserNssDbsLinux = vi.mocked( isCAImportedInUserNssDbsLinux );
+const mockedIsCATrustedOnLinux = vi.mocked( isCATrustedOnLinux );
+const mockedReadLinuxTrustCertificate = vi.mocked( readLinuxTrustCertificate );
+const mockedSudoExec = vi.mocked( sudo.exec );
+
+type SudoExecCallback = ( error?: Error, stdout?: string, stderr?: string ) => void;
+
+const setPlatform = ( platform: NodeJS.Platform ) => {
+	Object.defineProperty( process, 'platform', { value: platform, configurable: true } );
+};
+
+describe( 'certificate-manager Linux trust install', () => {
+	const originalPlatform = process.platform;
+	let existsSpy: ReturnType< typeof vi.spyOn >;
+
+	beforeEach( () => {
+		setPlatform( 'linux' );
+		existsSpy = vi.spyOn( fs, 'existsSync' ).mockReturnValue( true );
+		mockedAreAllFirefoxProfilesTrustedLinux.mockReset().mockResolvedValue( false );
+		mockedBuildLinuxTrustInstallCommand
+			.mockReset()
+			.mockReturnValue( 'write-authorized-bytes-to-fixed-trust-store' );
+		mockedGetLinuxTrustStoreConfig.mockClear();
+		mockedImportCAIntoFirefoxProfilesLinux.mockReset().mockResolvedValue( undefined );
+		mockedImportCAIntoUserNssDbsLinux.mockReset().mockResolvedValue( undefined );
+		mockedIsCAImportedInUserNssDbsLinux.mockReset().mockResolvedValue( false );
+		mockedIsCATrustedOnLinux.mockReset().mockResolvedValue( false );
+		mockedReadLinuxTrustCertificate
+			.mockReset()
+			.mockReturnValue( Buffer.from( 'authorized CA bytes' ) );
+		mockedSudoExec.mockReset().mockImplementation( ( ( ...args: unknown[] ) => {
+			const callback = args[ args.length - 1 ] as SudoExecCallback;
+			callback();
+		} ) as unknown as typeof sudo.exec );
+	} );
+
+	afterEach( () => {
+		existsSpy.mockRestore();
+		setPlatform( originalPlatform );
+	} );
+
+	it( 'snapshots the CA and builds the privileged command before authorization', async () => {
+		await trustRootCA();
+
+		expect( mockedReadLinuxTrustCertificate ).toHaveBeenCalledWith(
+			'/home/user/.studio/certificates/studio-ca.crt'
+		);
+		expect( mockedBuildLinuxTrustInstallCommand ).toHaveBeenCalledWith(
+			Buffer.from( 'authorized CA bytes' )
+		);
+		expect( mockedReadLinuxTrustCertificate.mock.invocationCallOrder[ 0 ] ).toBeLessThan(
+			mockedSudoExec.mock.invocationCallOrder[ 0 ]
+		);
+		expect( mockedBuildLinuxTrustInstallCommand.mock.invocationCallOrder[ 0 ] ).toBeLessThan(
+			mockedSudoExec.mock.invocationCallOrder[ 0 ]
+		);
+		expect( mockedSudoExec.mock.calls[ 0 ][ 0 ] ).not.toContain( '/home/user' );
+		expect( mockedImportCAIntoUserNssDbsLinux ).toHaveBeenCalledWith(
+			'/usr/local/share/ca-certificates/studio-ca.crt'
+		);
+		expect( mockedImportCAIntoFirefoxProfilesLinux ).toHaveBeenCalledWith(
+			'/usr/local/share/ca-certificates/studio-ca.crt'
+		);
+	} );
+
+	it( 'does not continue to authorization or NSS imports when the source is unsafe', async () => {
+		mockedReadLinuxTrustCertificate.mockImplementation( () => {
+			throw new Error( 'unsafe certificate source' );
+		} );
+
+		await expect( trustRootCA() ).rejects.toThrow( 'unsafe certificate source' );
+
+		expect( mockedSudoExec ).not.toHaveBeenCalled();
+		expect( mockedImportCAIntoUserNssDbsLinux ).not.toHaveBeenCalled();
+		expect( mockedImportCAIntoFirefoxProfilesLinux ).not.toHaveBeenCalled();
+	} );
+} );
