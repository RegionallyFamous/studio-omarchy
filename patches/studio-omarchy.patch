+			'umask 077',
+			`exec 9>'${ STUDIO_CA_INSTALL_LOCK }'`,
+			'/usr/bin/flock -x 9',
+			`/usr/bin/rm -f -- ${ cleanupPaths }`,
+			`/usr/bin/printf '%s' '${ encodedCertificate }' | /usr/bin/base64 --decode > '${ stagingPath }'`,
+			verifyFile( stagingPath ),
+			verifyDer( stagingPath ),
+			`/usr/bin/chmod 0644 '${ stagingPath }'`,
+			preservePreviousAnchor,
+			`/usr/bin/mv -fT -- '${ stagingPath }' '${ trustStorePath }'`,
+			verifyInstalledAnchor,
+			updateCommand,
+			verifyInstalledAnchor,
+			`/usr/bin/openssl verify -CAfile '${ LINUX_SYSTEM_CA_BUNDLE }' '${ trustStorePath }'`,
+			verifyInstalledAnchor,
+			`/usr/bin/rm -f -- '${ backupPath }' '${ noPreviousAnchorPath }'`,
+		].join( ' && ' ) + ` || { ${ rollback }; }`
+	);
 }
 
