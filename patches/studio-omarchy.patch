+import http from 'node:http';
+import net from 'node:net';
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import type { EventEmitter } from 'node:events';
+
+vi.mock( '@wp-playground/cli', () => ( { runCLI: vi.fn() } ) );
+vi.mock( '@wp-playground/storage', () => ( {
+	FetchFilesystem: class {},
+	InMemoryFilesystem: class {},
+	NodeJsFilesystem: class {},
+	OverlayFilesystem: class {},
+} ) );
+
+type PlaygroundServerChildModule = typeof import('../playground-server-child');
+
+let playgroundServerChild: PlaygroundServerChildModule;
+
+function removeAddedListeners(
+	emitter: EventEmitter,
+	event: string,
+	originalListeners: ReturnType< EventEmitter[ 'listeners' ] >
+): void {
+	for ( const listener of emitter.listeners( event ) ) {
+		if ( ! originalListeners.includes( listener ) ) {
+			emitter.removeListener( event, listener as ( ...args: unknown[] ) => void );
+		}
+	}
+}
+
+beforeAll( async () => {
+	const processEmitter = process as EventEmitter;
+	const originalSend = process.send;
+	const originalConsole = {
+		log: console.log,
+		error: console.error,
+		warn: console.warn,
+	};
+	const originalStdoutWrite = process.stdout.write;
+	const originalStderrWrite = process.stderr.write;
+	const originalListeners = {
+		message: process.listeners( 'message' ),
+		uncaughtException: process.listeners( 'uncaughtException' ),
+		unhandledRejection: process.listeners( 'unhandledRejection' ),
+	};
+
+	process.send = vi.fn() as typeof process.send;
+	try {
+		playgroundServerChild = await import( '../playground-server-child' );
+	} finally {
+		console.log = originalConsole.log;
+		console.error = originalConsole.error;
+		console.warn = originalConsole.warn;
+		process.stdout.write = originalStdoutWrite;
+		process.stderr.write = originalStderrWrite;
+
+		removeAddedListeners( processEmitter, 'message', originalListeners.message );
+		removeAddedListeners(
+			processEmitter,
+			'uncaughtException',
+			originalListeners.uncaughtException
+		);
+		removeAddedListeners(
+			processEmitter,
+			'unhandledRejection',
+			originalListeners.unhandledRejection
+		);
+
+		process.send = originalSend;
+	}
+} );
+
+afterAll( () => {
+	vi.restoreAllMocks();
+} );
+
+async function closeServer( server: http.Server ): Promise< void > {
+	await new Promise< void >( ( resolve ) => server.close( () => resolve() ) );
+}
+
+function expectIpv4Loopback( server: http.Server ): void {
+	const address = server.address();
+	expect( address ).not.toBeNull();
+	expect( typeof address ).toBe( 'object' );
+	expect( ( address as net.AddressInfo ).address ).toBe( '127.0.0.1' );
+}
+
+describe( 'Playground CLI network binding', () => {
+	it( 'confines the hostless listen signature used by Playground CLI to IPv4 loopback', async () => {
+		const server = http.createServer();
+
+		await playgroundServerChild.withPlaygroundCliLoopbackBinding(
+			() =>
+				new Promise< void >( ( resolve, reject ) => {
+					server.once( 'error', reject );
+					server.listen( 0, resolve );
+				} )
+		);
+
+		expectIpv4Loopback( server );
+		await closeServer( server );
+	} );
+
+	it( 'overrides an explicit wildcard host in listen options', async () => {
+		const server = http.createServer();
+
+		await playgroundServerChild.withPlaygroundCliLoopbackBinding(
+			() =>
+				new Promise< void >( ( resolve, reject ) => {
+					server.once( 'error', reject );
+					server.listen( { port: 0, host: '0.0.0.0' }, resolve );
+				} )
+		);
+
+		expectIpv4Loopback( server );
+		await closeServer( server );
+	} );
+
+	it( 'restores the Node listener after startup failure', async () => {
+		const originalListen = net.Server.prototype.listen;
+
+		await expect(
+			playgroundServerChild.withPlaygroundCliLoopbackBinding( async () => {
+				throw new Error( 'startup failed' );
+			} )
+		).rejects.toThrow( 'startup failed' );
+
+		expect( net.Server.prototype.listen ).toBe( originalListen );
+	} );
+
+	it( 'keeps concurrent Playground startup operations confined until both settle', async () => {
+		const originalListen = net.Server.prototype.listen;
+		let releaseFirst = () => {};
+		let releaseSecond = () => {};
+		const first = playgroundServerChild.withPlaygroundCliLoopbackBinding(
+			() =>
+				new Promise< void >( ( resolve ) => {
+					releaseFirst = resolve;
+				} )
+		);
+		const second = playgroundServerChild.withPlaygroundCliLoopbackBinding(
+			() =>
+				new Promise< void >( ( resolve ) => {
+					releaseSecond = resolve;
+				} )
+		);
+
+		expect( net.Server.prototype.listen ).not.toBe( originalListen );
+		releaseFirst();
+		await first;
+		expect( net.Server.prototype.listen ).not.toBe( originalListen );
+		releaseSecond();
+		await second;
+		expect( net.Server.prototype.listen ).toBe( originalListen );
+	} );
+} );
